# Copy to apps/web/.env.local to override defaults from .env.development.

NEAR_NETWORK_ID=localnet
NEAR_RPC_URL=http://127.0.0.1:3030
NEAR_CONTRACT_ID=paidaid.sandbox

NEXT_PUBLIC_NEAR_NETWORK_ID=localnet
NEXT_PUBLIC_NEAR_RPC_URL=http://127.0.0.1:3030
NEXT_PUBLIC_NEAR_CONTRACT_ID=paidaid.sandbox

# Supabase (marketplace auth).
# Hosted: Dashboard → Settings → API (anon public key).
# Local Docker (`pnpm db:start`): use `supabase status` — this repo uses API http://127.0.0.1:55321 by default
# (5532x) so another project (e.g. Active on 5432x) can run at the same time.
# Never put the service role key in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
# Optional: server/middleware fallbacks (same values as above in most setups)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Phase 2 — request photos use Storage bucket `request-photos` (created by migration).
