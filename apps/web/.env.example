# Copy to apps/web/.env.local to override defaults from .env.development.

NEAR_NETWORK_ID=localnet
NEAR_RPC_URL=http://127.0.0.1:3030
NEAR_CONTRACT_ID=paidaid.sandbox

NEXT_PUBLIC_NEAR_NETWORK_ID=localnet
NEXT_PUBLIC_NEAR_RPC_URL=http://127.0.0.1:3030
NEXT_PUBLIC_NEAR_CONTRACT_ID=paidaid.sandbox

# Supabase (marketplace auth) — get these from your Supabase project API settings.
# For local Supabase CLI, http://127.0.0.1:54321 is allowed by the app validator.
# Never commit real values. Do not put the service role key in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: server/middleware fallbacks (same values as above in most setups)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
