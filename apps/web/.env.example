# Copy to apps/web/.env.local (gitignored). Dev defaults: `.env.development`.

# --- Localnet (sandbox + local Supabase) ---
# NEAR_NETWORK_ID=localnet
# NEAR_RPC_URL=http://127.0.0.1:3030
# NEAR_CONTRACT_ID=paidaid.sandbox
# NEAR_ESCROW_CONTRACT_ID=paidaid-escrow.sandbox
# NEXT_PUBLIC_NEAR_NETWORK_ID=localnet
# NEXT_PUBLIC_NEAR_RPC_URL=http://127.0.0.1:3030
# NEXT_PUBLIC_NEAR_CONTRACT_ID=paidaid.sandbox
# NEXT_PUBLIC_NEAR_ESCROW_CONTRACT_ID=paidaid-escrow.sandbox
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=…from supabase status…
# SUPABASE_SERVICE_ROLE_KEY=…from supabase status…

# --- Hosted testnet + Supabase (Vercel / production preview) ---
NEAR_NETWORK_ID=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=your.testnet
NEAR_ESCROW_CONTRACT_ID=paidaid-escrow.your.testnet
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_CONTRACT_ID=your.testnet
NEXT_PUBLIC_NEAR_ESCROW_CONTRACT_ID=paidaid-escrow.your.testnet

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Deploy escrow: `pnpm testnet:deploy-escrow` (local only; do not set on Vercel)
# NEAR_ESCROW_OWNER_ACCOUNT_ID=your.testnet
# NEAR_ESCROW_OWNER_PRIVATE_KEY=ed25519:…

# Out of scope unless using bridge payouts
ONECLICK_MODE=demo

# Never put the service role key in NEXT_PUBLIC_* vars.
