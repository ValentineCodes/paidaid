{
  "name": "paidaid",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm --filter @paidaid/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test && pnpm contract:test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write . && cargo fmt --all --manifest-path contracts/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --all --manifest-path contracts/Cargo.toml -- --check",
    "contract:clippy": "cargo clippy --all-targets --manifest-path contracts/Cargo.toml -- -D warnings",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contract:check": "cargo check --target wasm32-unknown-unknown --manifest-path contracts/Cargo.toml",
    "contract:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path contracts/Cargo.toml",
    "sandbox:reset": "node scripts/sandbox/reset.mjs",
    "sandbox:start": "node scripts/sandbox/start.mjs",
    "sandbox:stop": "node scripts/sandbox/stop.mjs",
    "sandbox:deploy": "node scripts/sandbox/deploy.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm contract:clippy && pnpm test && pnpm contract:check"
  },
  "devDependencies": {
    "@near-js/accounts": "2.2.5",
    "@near-js/crypto": "2.2.5",
    "@near-js/providers": "2.2.5",
    "@near-js/signers": "2.2.5",
    "@near-js/tokens": "2.5.1",
    "near-sandbox": "0.3.5",
    "prettier": "^3.6.2",
    "tsx": "4.19.4"
  },
  "pnpm": {
    "overrides": {
      "@near-js/accounts": "2.5.1",
      "@near-js/crypto": "2.5.1",
      "@near-js/keystores": "2.5.1",
      "@near-js/keystores-browser": "2.5.1",
      "@near-js/providers": "2.5.1",
      "@near-js/signers": "2.5.1",
      "@near-js/transactions": "2.5.1",
      "@near-js/types": "2.5.1",
      "@near-js/utils": "2.5.1"
    }
  }
}
